{
  "name": "GoalReview",
  "description": "Submit the host agent conclusion after an independent descriptive report. mode=continue submits only candidate, summary, remaining_requirements and a concrete next_step for explicitly unfinished contract work. It cannot complete or block the goal. mode=full (default) submits verdict and every requirement with inspected evidence. Required full audits cannot use continue. Validation rejection is feedback: correct it and call again in the same host adjudication turn.",
  "input_schema": {
    "type": "object",
    "properties": {
      "verdict": {
        "type": "string",
        "enum": [
          "satisfied",
          "needs_work",
          "blocked"
        ]
      },
      "candidate": {
        "type": "object",
        "properties": {
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "goal_id": {
            "type": "string"
          },
          "contract_revision": {
            "type": "integer",
            "minimum": 1
          },
          "iteration": {
            "type": "integer",
            "minimum": 1
          },
          "conversation_seq": {
            "type": "integer",
            "minimum": 0
          },
          "reviewer_id": {
            "type": "string"
          }
        },
        "required": [
          "generation",
          "goal_id",
          "contract_revision",
          "iteration",
          "conversation_seq",
          "reviewer_id"
        ],
        "additionalProperties": false
      },
      "criteria": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "criterion_id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "description": "Explain the observed facts here; evidence holds references only."
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only existing workspace file paths (relative or absolute), file:// paths, or artifact://ID references inspected with Read. Never put descriptions, command text, excerpts, line labels, or missing paths here. Use [] when evidence is unavailable; explain observations in reason/summary."
            }
          },
          "required": [
            "criterion_id",
            "status",
            "reason",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "constraints": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "constraint": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "description": "Explain the observed facts here; evidence holds references only."
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only existing workspace file paths (relative or absolute), file:// paths, or artifact://ID references inspected with Read. Never put descriptions, command text, excerpts, line labels, or missing paths here. Use [] when evidence is unavailable; explain observations in reason/summary."
            }
          },
          "required": [
            "constraint",
            "status",
            "reason",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "summary": {
        "type": "string"
      },
      "next_step": {
        "type": "string"
      },
      "blocker": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependency": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only existing workspace file paths (relative or absolute), file:// paths, or artifact://ID references inspected with Read. Never put descriptions, command text, excerpts, line labels, or missing paths here. Use [] when evidence is unavailable; explain observations in reason/summary."
          }
        },
        "required": [
          "category",
          "criterion_ids",
          "dependency",
          "evidence"
        ],
        "additionalProperties": false
      },
      "original_request": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Explain the observed facts here; evidence holds references only."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only existing workspace file paths (relative or absolute), file:// paths, or artifact://ID references inspected with Read. Never put descriptions, command text, excerpts, line labels, or missing paths here. Use [] when evidence is unavailable; explain observations in reason/summary."
          }
        },
        "required": [
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      },
      "mode": {
        "type": "string",
        "enum": [
          "full",
          "continue"
        ],
        "description": "Omitted mode means full. continue is negative-only scheduling, never acceptance."
      },
      "remaining_requirements": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        },
        "description": "Only requirement_ids from GoalRead. Required for continue, forbidden for full."
      }
    },
    "required": [
      "candidate",
      "summary",
      "next_step"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "properties": {
          "mode": {
            "const": "continue"
          }
        },
        "required": [
          "mode",
          "remaining_requirements"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "verdict"
              ]
            },
            {
              "required": [
                "criteria"
              ]
            },
            {
              "required": [
                "constraints"
              ]
            },
            {
              "required": [
                "blocker"
              ]
            },
            {
              "required": [
                "original_request"
              ]
            }
          ]
        }
      },
      {
        "properties": {
          "mode": {
            "const": "full"
          }
        },
        "required": [
          "verdict",
          "original_request",
          "criteria",
          "constraints",
          "blocker"
        ],
        "not": {
          "required": [
            "remaining_requirements"
          ]
        }
      }
    ]
  }
}
