# mink gitignore

# Build artifacts
target/
dist/
mink_agent/_binary/

# OS files
.DS_Store
Thumbs.db

# Configuration
.dscoderc

# Python
__pycache__/
*.pyc
*.egg-info/
build/

# Local temp
test.py
skill_x.md
missions/
experiments/*
experiments/
cpython-wasi/
.minkrc
sandbox-poc/
# Local captured model trajectories may contain prompts, reasoning, request
# metadata, paths, or endpoints. Never stage raw captures.
reference-trajectory/

node_modules/
data/
test-results/
playwright-report/

# 开发过程文档（仅本地保留，不入库）
docs/QUALITY_ACTION_PLAN-*.md
docs/STABILITY_SIMPLIFICATION_PLAN-*.md
docs/AUDIT-*.md
docs/CORE_CLI_CONVERGENCE_DESIGN.md

# 审核报告与实施计划（仅本地保留，不入库）
docs/audits/
docs/CORE_MAINTAINABILITY_*.md
docs/QUALITY_CONVERGENCE_PLAN-*.md
docs/QUALITY_DEEP_AUDIT-*.md
docs/LLM_RECOVERY_IMPLEMENTATION_PLAN-*.md
docs/LLM_RECOVERY_AUDIT-*.md

# Local review records and implementation plans
/docs/local/
/docs/**/*PLAN*.md
/docs/**/*AUDIT*.md
/docs/**/*REVIEW*.md
/docs/**/*ROADMAP*.md
/docs/**/*implementation-plan*.md
/docs/**/*action-plan*.md
/docs/**/release-audit-*.md
/docs/**/*实施计划*.md
